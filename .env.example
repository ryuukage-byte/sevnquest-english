# ============================================================================
# SevnQuest (English edition) - example configuration
# Copy to .env (git-ignored). Never commit real secret values.
# ============================================================================

# --- Client (bundled into the browser; anything starting with VITE_ is PUBLIC) ---
# Use YOUR OWN Supabase project. Leave empty to run fully in the browser (no cloud save / leaderboard).
# Never put the service_role key here.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Show the Google sign-in button (enable the Google provider in Supabase first, and fill the client id)
VITE_GOOGLE_AUTH=""
VITE_GOOGLE_CLIENT_ID=""

# Use the secure leaderboard RPCs (only if your Supabase project has those migrations)
VITE_SECURE_LEADERBOARD=""

# --- AI deck builder (optional; server function api/deck-topic.ts). NOT prefixed with VITE_ ---
# Any OpenAI-compatible chat/completions provider. Empty = local matching only.
DECK_AI_BASE_URL=""
DECK_AI_API_KEY=""
DECK_AI_MODEL=""
